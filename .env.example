# InvoiceOCR Pipeline — Environment Variables
# Copy this file to .env and fill in your values.

# Tesseract executable path (Windows default shown)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler bin path (required by pdf2image on Windows)
# Download from: https://github.com/oschwartz10612/poppler-windows/releases
POPPLER_PATH=

# SMTP settings for daily email summary
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Database path (default: local SQLite)
DATABASE_PATH=data/invoices.db
