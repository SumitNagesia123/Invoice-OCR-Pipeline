# InvoiceOCR Pipeline — Environment Variables
# Copy this file to .env and fill in your values.

# Tesseract executable path (Windows default shown)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Poppler bin path (required by pdf2image on Windows)
# Download from: https://github.com/oschwartz10612/poppler-windows/releases
POPPLER_PATH=

# Database settings (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=invoice_ocr
DB_USER=root
DB_PASSWORD=

# Anthropic API Key (required for LLM extraction mode)
ANTHROPIC_API_KEY=

# Extraction mode: true = mock mode (no cost, dummy data), false = real Anthropic Claude API
MOCK_EXTRACTOR=true

# SMTP settings for daily email summary
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
